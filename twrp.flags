# TWRP user-facing partitions and flags
# <mount_point>         <fs_type>       <device_block>                                  <flags>

# Removable storage
/external_sd            auto            /dev/block/mmcblk1p1    /dev/block/mmcblk1      flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg                auto            /dev/block/sda1         /dev/block/sda          flags=display="USB-OTG";storage;wipeingui;removable

# Firmware & Core partitions
/boot                   emmc            /dev/block/by-name/boot                         flags=display="Boot";backup=1;flashimg=1;slotselect
/dtbo                   emmc            /dev/block/by-name/dtbo                         flags=display="DTBO";backup=1;flashimg=1;slotselect
/dtb                    emmc            /dev/block/by-name/dtb                          flags=display="DTB";backup=1;flashimg=1;slotselect
/vbmeta                 emmc            /dev/block/by-name/vbmeta                       flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system          emmc            /dev/block/by-name/vbmeta_system                flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor          emmc            /dev/block/by-name/vbmeta_vendor                flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect

# NVRAM / Calibration data
/prodnv                 ext4            /dev/block/by-name/prodnv                       flags=display="Prodnv";backup=1
/persist                ext4            /dev/block/by-name/persist                      flags=display="Persist";backup=1

# Super sub-partitions for backup/flash
/system_image           emmc            /dev/block/bootdevice/by-name/super             flags=display="System Image";backup=1;flashimg=1
/vendor_image           emmc            /dev/block/bootdevice/by-name/super             flags=display="Vendor Image";backup=1;flashimg=1
/product_image          emmc            /dev/block/bootdevice/by-name/super             flags=display="Product Image";backup=1;flashimg=1
