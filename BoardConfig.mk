DEVICE_PATH := device/realme/RMX3269

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := generic

TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic

# Board / Platform
TARGET_BOARD_PLATFORM := ums512
BOARD_USES_UNISOC_HARDWARE := true

# Bootloader / Assert
TARGET_BOOTLOADER_BOARD_NAME := ums512_1h10
TARGET_NO_BOOTLOADER := true

# Kernel & Boot Image Header v2
BOARD_KERNEL_CMDLINE := console=ttyS1,115200n8 video=HDMI-A-1:1280x800@60 buildvariant=user androidboot.hardware=RMX3265
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_OFFSET := 0x00008000
BOARD_RAMDISK_OFFSET := 0x05400000
BOARD_TAGS_OFFSET := 0x00000100
BOARD_DTB_OFFSET := 0x05400000
BOARD_BOOT_HEADER_VERSION := 2
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)

# Kernel Prebuilts
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
BOARD_PREBUILT_DTBIMAGE_DIR := $(DEVICE_PATH)/prebuilt
BOARD_INCLUDE_DTB_IN_BOOTIMG := true

# A/B and Recovery in Boot
AB_OTA_UPDATER := true
BOARD_BUILD_SYSTEM_ROOT_IMAGE := false
BOARD_USES_RECOVERY_AS_BOOT := true

# Partitions Sizes
BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_DTBOIMG_PARTITION_SIZE := 8388608
BOARD_HAS_NO_REAL_SDCARD := true

# Dynamic Partitions
BOARD_SUPER_PARTITION_SIZE := 9961472000
BOARD_SUPER_PARTITION_GROUPS := group_unisoc
BOARD_GROUP_UNISOC_SIZE := 9961472000
BOARD_GROUP_UNISOC_PARTITION_LIST := system system_ext vendor product

# File Systems
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
BOARD_USES_METADATA_PARTITION := true

# Recovery UI / Display
TW_THEME := portrait_hdpi
TW_SCREEN_WIDTH := 720
TW_SCREEN_HEIGHT := 1600
TARGET_SCREEN_DENSITY := 320
TW_BRIGHTNESS_PATH := "/sys/class/backlight/sprd_backlight/brightness"
TW_MAX_BRIGHTNESS := 255
TW_DEFAULT_BRIGHTNESS := 150
TW_INPUT_BLACKLIST := "hbtp_vm"

# Touch & Vibration
TW_SUPPORT_INPUT_1_2_HACKS := true

# USB & Toolbox
TW_USE_TOOLBOX := true
TW_EXCLUDE_DEFAULT_USB_INIT := true

# Decryption / Keymaster
TW_INCLUDE_CRYPTO := true
TW_INCLUDE_CRYPTO_FBE := true
TW_INCLUDE_FBE_METADATA_DECRYPT := true

# OrangeFox Configuration
FOX_USE_TWRP_RECOVERY_IMAGE_BUILDER := 1
OF_MAINTAINER := "visEXE | KSN"
FOX_MAINTAINER_PATCH_VERSION := "1"
FOX_BUILD_TYPE := "Unofficial"
OF_SCREEN_H := 1600
OF_STATUS_H := 80
OF_STATUS_INDENT_LEFT := 48
OF_STATUS_INDENT_RIGHT := 48
OF_CLOCK_POS := 1
OF_ALLOW_DISABLE_NAVBAR := 0
OF_NO_TREBLE_COMPATIBILITY_CHECK := 1
OF_NO_SPLASH_CHANGE := 1
OF_USE_MAGISKBOOT := 1
OF_USE_MAGISKBOOT_FOR_ALL_PATCHES := 1
OF_DONT_PATCH_ON_MOUNT := 1
OF_KEEP_FORCED_ENCRYPTION := 1
OF_QUICK_BACKUP_LIST := "/boot;/data;/super;"
OF_PATCH_AVB20 := 1
