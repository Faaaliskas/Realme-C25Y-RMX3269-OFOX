system                                   /system             ext4    ro wait,avb=vbmeta_system,logical,first_stage_mount,slotselect
system_ext                               /system_ext         ext4    ro wait,avb=vbmeta_system_ext,logical,first_stage_mount,slotselect
vendor                                   /vendor             ext4    ro wait,avb=vbmeta_vendor,logical,first_stage_mount,slotselect
product                                  /product            ext4    ro wait,avb=vbmeta_product,logical,first_stage_mount,slotselect

/dev/block/by-name/misc                  /misc               emmc    defaults     defaults

/dev/block/by-name/socko                 /socko              ext4    ro,noatime,nosuid,nodev,noauto_da_alloc wait,latemount,avb=socko,check,slotselect
/dev/block/by-name/odmko                 /odmko              ext4    ro,noatime,nosuid,nodev,noauto_da_alloc wait,latemount,avb=odmko,check,slotselect

/dev/block/by-name/metadata              /metadata           ext4    nodev,noatime,nosuid,errors=panic wait,formattable,first_stage_mount,check
/dev/block/by-name/userdata              /data               f2fs    noatime,nosuid,nodev,discard,inline_xattr,inline_data,inlinecrypt latemount,wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,formattable
/dev/block/by-name/prodnv                /mnt/vendor         ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc wait,check
/dev/block/by-name/cache                 /cache              ext4    noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc wait,check

/dev/block/mmcblk0boot0                  /spl                emmc    defaults slotselect
/dev/block/mmcblk0boot1                  /spl_bk             emmc    defaults defaults
/dev/block/by-name/uboot                 /uboot              emmc    defaults slotselect
/dev/block/by-name/sml                   /sml                emmc    defaults slotselect
/dev/block/by-name/trustos               /tos                emmc    defaults slotselect
/dev/block/by-name/teecfg                /teecfg             emmc    defaults slotselect

/dev/block/mmcblk1p1                     /external_sd        vfat    defaults      defaults,check
